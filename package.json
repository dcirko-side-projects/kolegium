{
  "name": "kolegium",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build && node scripts/build-pwa.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:pwa:release": "node scripts/test-pwa.mjs --release",
    "test:watch": "node scripts/run-tests.mjs watch",
    "test:e2e": "playwright test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators:start": "node scripts/emulators.mjs",
    "emulators:test": "node scripts/emulators.mjs test",
    "auth:seed": "node scripts/seed-local-auth.mjs",
    "auth:seed:test": "node scripts/seed-local-auth.mjs test",
    "start:e2e": "ng serve --configuration e2e --host 127.0.0.1 --port 4300",
    "test:rules": "node scripts/run-tests.mjs rules",
    "release:prepare-rules": "node scripts/prepare-release-rules.mjs",
    "release:build": "node scripts/prepare-release-rules.mjs && ng build --configuration production,release && node scripts/build-pwa.mjs",
    "test:release-rules": "node scripts/run-tests.mjs release-rules",
    "test:integration": "node scripts/run-tests.mjs integration"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "firebase": "12.19.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "firebase-tools": "15.33.0",
    "jsdom": "28.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
